{
	"info": {
		"_postman_id": "edu-match-api-collection",
		"name": "EduMatch API Refactored",
		"description": "Bộ sưu tập các request cho hệ thống EduMatch sau khi refactor (Auth, Tutors, Applications)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@gmail.com\",\n    \"fullName\": \"Test User\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/register" }
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@gmail.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/login" }
					}
				},
				{
					"name": "Admin Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/admin/login" }
					}
				},
				{
					"name": "Tutor Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"tutor_user\",\n    \"password\": \"tutor_pass\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/login-tutor" }
					}
				},
				{
					"name": "Get Me",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/api/auth/me" }
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"url": { "raw": "{{base_url}}/api/auth/logout" }
					}
				}
			]
		},
		{
			"name": "Forgot Password",
			"item": [
				{
					"name": "1. Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@gmail.com\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/forgot-password" }
					}
				},
				{
					"name": "2. Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@gmail.com\",\n    \"otp\": \"123456\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/verify-otp" }
					}
				},
				{
					"name": "3. Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@gmail.com\",\n    \"password\": \"NewPassword123!\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/auth/reset-password" }
					}
				}
			]
		},
		{
			"name": "Tutors Management",
			"item": [
				{
					"name": "Get All Tutors",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/api/tutors" }
					}
				},
				{
					"name": "Create Tutor",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"Gia Sư Mới\",\n    \"email\": \"giasu@gmail.com\",\n    \"gender\": \"Nam\",\n    \"age\": 28,\n    \"subject\": \"Toán, Lý\",\n    \"qualification\": \"Cử nhân Sư phạm\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/tutors" }
					}
				},
				{
					"name": "Grant Tutor Account",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"giasu01\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/tutors/1/grant-account" }
					}
				}
			]
		},
		{
			"name": "Tutor Applications",
			"item": [
				{
					"name": "1. Apply Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"apply_giasu@gmail.com\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/tutors/apply/send-otp" }
					}
				},
				{
					"name": "2. Get Applications",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/api/tutors/applications" }
					}
				},
				{
					"name": "3. Approve Application",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"interviewTime\": \"10:00 AM, 10/10/2025\",\n    \"interviewAddress\": \"Tầng 3, Tòa nhà EduMatch\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/tutors/applications/1/approve" }
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": { "type": "text/javascript", "exec": [""] }
		},
		{
			"listen": "test",
			"script": { "type": "text/javascript", "exec": [""] }
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3001", "type": "string" }
	]
}