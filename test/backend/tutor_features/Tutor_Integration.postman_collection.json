    {
      "name": "[TUT-01 NEG] Ứng Tuyển Thiếu Email & CV (Bad Request Validation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Negative] Missing email returns 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('[Negative] Error message clearly indicates missing email or CV', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message || json.error).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Tutor No Email\",\n  \"gender\": \"Nam\",\n  \"age\": 25,\n  \"subject\": \"Toán\"\n}"
