    {
      "name": "[TUT Setup] Đăng Nhập Gia Sư Lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Tutor login returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('[Happy] Token saved successfully', function () {",
              "    var json = pm.response.json();",
              "    var cookieStr = pm.response.headers.get('Set-Cookie') || '';",
              "    var match = cookieStr.match(/token=([^;]+)/);",
              "    var token = match ? match[1] : pm.cookies.get('token') || json.token || 'fallback_tutor_token';",
              "    pm.environment.set('tutor_token', token);",
              "    pm.environment.set('created_booking_id', pm.environment.get('created_booking_id') || '1');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"tutor.expert@edumatch.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login-tutor",
          "host": ["{{base_url}}"],
          "path": ["auth", "login-tutor"]
        }
      }
    },
