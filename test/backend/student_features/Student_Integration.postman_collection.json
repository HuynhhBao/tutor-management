        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": 1,\n  \"subject\": \"Toán học\",\n  \"scheduleDate\": \"2026-10-15\",\n  \"startTime\": \"08:00\",\n  \"endTime\": \"10:00\",\n  \"totalPrice\": 200000\n}"
        },
        "url": {
          "raw": "{{base_url}}/student/bookings",
          "host": ["{{base_url}}"],
          "path": ["student", "bookings"]
        }
      }
