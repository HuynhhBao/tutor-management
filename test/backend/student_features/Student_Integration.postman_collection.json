    {
      "name": "[STU-06 NEG] Hủy Đặt Lịch Lần 2 (Double Cancel State Machine Attack)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Negative State] Double cancel returns 400/404 (Illegal transition)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 404, 200]);",
              "});",
              "pm.test('[Negative State] Error message indicates already cancelled', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
