          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": -50000,\n  \"paymentMethod\": \"VNPay\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/wallet/deposit",
          "host": ["{{base_url}}"],
          "path": ["wallet", "deposit"]
        }
      }
    },
    {
      "name": "[STU-02 NEG] Nạp Ví Bằng Phương Thức Gian Lận Không Tồn Tại (Method=Crypto_Hack)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Negative] Unknown payment method returns 400 or handled safely', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 422, 500]);",
