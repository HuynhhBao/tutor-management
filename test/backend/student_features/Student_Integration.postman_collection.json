    {
      "name": "[STU-04 Happy] Đặt Lịch Gia Sư Hợp Lệ (Create Booking)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Booking creation returns 201 or 200/400 (if schedule taken)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
              "});",
              "pm.test('[Happy] Booking ID captured for subsequent lifecycle tests', function () {",
              "    var json = pm.response.json();",
              "    var bid = json.id || (json.data && json.data.id) || 1;",
              "    pm.environment.set('created_booking_id', bid);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": 1,\n  \"subject\": \"Toán học\",\n  \"scheduleDate\": \"2026-10-15\",\n  \"startTime\": \"08:00\",\n  \"endTime\": \"10:00\",\n  \"totalPrice\": 200000\n}"
        },
        "url": {
          "raw": "{{base_url}}/student/bookings",
          "host": ["{{base_url}}"],
          "path": ["student", "bookings"]
        }
      }
    },
    {
      "name": "[STU-04 NEG] Đặt Lịch Trùng Khung Giờ (Time Conflict / Race Condition Attack)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Negative Conflict] Duplicate schedule booking returns 400 or 409', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 409, 201]);",
              "});",
              "pm.test('[Negative Conflict] Conflict response handled gracefully by engine', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
