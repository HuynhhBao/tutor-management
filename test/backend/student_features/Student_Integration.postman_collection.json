      "name": "[STU-03 Happy] Xem Thông Tin Ví & Lịch Sử Giao Dịch",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Get wallet info returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('[Happy] Wallet object returned', function () {",
              "    var json = pm.response.json();",
