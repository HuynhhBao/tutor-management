    {
      "name": "[STU-06 Happy] Hủy Đặt Lịch Gia Sư Hợp Lệ (Cancel Booking)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Cancel booking returns 200/400/404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
              "});",
              "pm.test('[Happy] Cancel status response structure valid', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
