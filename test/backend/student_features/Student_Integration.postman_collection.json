{
  "info": {
    "_postman_id": "backend-student-integration-v3",
    "name": "Student Features & Escrow - Deep QA Integration Suite",
    "description": "Bộ kiểm thử CHUYÊN SÂU cho Học viên với định dạng chuẩn sạch đẹp (multi-line indentation). Tăng cường các test case Negative, Boundary Value Analysis (Nạp ví âm, quá hạn ngạch), xung đột trạng thái (Double Cancel), tấn công thời gian quá khứ và lỗi cú pháp ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[STU Setup] Đăng Ký Tài Khoản Học Viên",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var rand = Math.floor(Math.random() * 899999) + 100000;",
              "pm.environment.set('stu_email', 'student_deep_' + rand + '@gmail.com');",
              "pm.environment.set('stu_pass', 'SecureP@ss123!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Setup] Register Student OK (201 Created)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Student Deep QA\",\n  \"email\": \"{{stu_email}}\",\n  \"password\": \"{{stu_pass}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "[STU Setup] Đăng Nhập Học Viên Lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Setup] Login student returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('[Setup] Student token saved in environment', function () {",
              "    var json = pm.response.json();",
              "    var cookieStr = pm.response.headers.get('Set-Cookie') || '';",
              "    var match = cookieStr.match(/token=([^;]+)/);",
              "    var token = match ? match[1] : pm.cookies.get('token') || json.token || 'fallback_student_token';",
              "    pm.environment.set('student_token', token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{stu_email}}\",\n  \"password\": \"{{stu_pass}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "[STU-01 Happy] Bộ Lọc Tìm Kiếm Gia Sư Hợp Lệ (subject=Toán)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Filter tutors returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('[Happy] Array of tutors returned', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data || json).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tutors?subject=Toán",
          "host": ["{{base_url}}"],
          "path": ["tutors"],
          "query": [
            {
              "key": "subject",
              "value": "Toán"
            }
          ]
        }
      }
    },
    {
      "name": "[STU-01 NEG] Lọc Gia Sư Với Từ Khóa Đặc Biệt / SQLi Injection",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Negative] Malicious query parameter handled safely without crashing (200/400)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 500]);",
              "});",
              "pm.test('[Negative] No unhandled DB exception exposed in response', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tutors?subject=' OR '1'='1",
          "host": ["{{base_url}}"],
          "path": ["tutors"],
          "query": [
            {
              "key": "subject",
              "value": "' OR '1'='1"
            }
          ]
        }
      }
    },
    {
      "name": "[STU-02 Happy] Nạp Tiền Vào Ví Hợp Lệ (+500,000đ)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Deposit valid amount returns 200/201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('[Happy] Deposit successfully updated wallet balance', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500000,\n  \"paymentMethod\": \"VNPay\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/wallet/deposit",
          "host": ["{{base_url}}"],
          "path": ["wallet", "deposit"]
        }
      }
    },
    {
      "name": "[STU-02 NEG] Nạp Ví Với Số Tiền Âm (BVA Attack -50,000đ)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[BVA Negative] Negative deposit returns 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('[BVA Negative] Error message clearly indicates positive integer requirement', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message || json.error).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
