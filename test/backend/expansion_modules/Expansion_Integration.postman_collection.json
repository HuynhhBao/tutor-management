    {
      "name": "[EXP-01 NEG] AI Matchmaker Truyền Prompt Dài Khủng Khiếp (Buffer Overflow Attack 5000 chars)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var hugeString = 'Tìm gia sư ' + 'A'.repeat(5000);",
              "pm.environment.set('huge_prompt', hugeString);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Negative] Giant prompt is handled gracefully (200/400/413/500)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 413, 500]);",
              "});",
              "pm.test('[Negative] No unhandled fatal exception occurred', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"{{huge_prompt}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/ai/matchmaker",
          "host": ["{{base_url}}"],
          "path": ["ai", "matchmaker"]
        }
      }
    },
