{
  "info": {
    "_postman_id": "backend-expansion-integration-v3",
    "name": "Expansion Modules & AI/Classroom - Deep QA Integration Suite",
    "description": "Bộ kiểm thử CHUYÊN SÂU cho Module Mở Rộng (AI Matchmaker, Virtual Classroom, Chat, Notifications, Redis) với định dạng chuẩn sạch sẽ (multi-line indentation). Tăng cường bẫy lỗi Bad Input, Buffer Overflow prompts, syntax error snapshots và RBAC security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[EXP Setup] Đăng Ký Tài Khoản Học Viên Mở Rộng",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var r = Math.floor(Math.random() * 899999) + 100000;",
              "pm.environment.set('exp_email', 'exp_qa_' + r + '@gmail.com');",
              "pm.environment.set('exp_pass', 'SecureP@ss123!');",
              "pm.environment.set('created_booking_id', pm.environment.get('created_booking_id') || '1');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Register returns 201 Created or handled', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"EXP QA Tester\",\n  \"email\": \"{{exp_email}}\",\n  \"password\": \"{{exp_pass}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "[EXP Setup] Đăng Nhập Lấy Token Mở Rộng",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Login returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('[Happy] Student token captured for AI and Classroom tests', function () {",
              "    var json = pm.response.json();",
              "    var cookieStr = pm.response.headers.get('Set-Cookie') || '';",
              "    var match = cookieStr.match(/token=([^;]+)/);",
              "    var token = match ? match[1] : pm.cookies.get('token') || json.token || 'fallback_token';",
              "    pm.environment.set('student_token', token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{exp_email}}\",\n  \"password\": \"{{exp_pass}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "[EXP-01 Happy] Trợ Lý AI Matchmaker Gợi Ý Gia Sư Hợp Lệ",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] AI matchmaker returns 200/400/500 (API key dependent)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 500, 503]);",
              "});",
              "pm.test('[Happy] Response is valid JSON', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Tìm gia sư Toán lớp 12 ôn thi đại học, kinh nghiệm trên 5 năm\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/ai/matchmaker",
          "host": ["{{base_url}}"],
          "path": ["ai", "matchmaker"]
        }
      }
    },
