  "item": [
    {
      "name": "[ADM Setup] Đăng Nhập Admin Lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Admin Login returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('[Happy] Admin token saved successfully', function () {",
              "    var json = pm.response.json();",
              "    var cookieStr = pm.response.headers.get('Set-Cookie') || '';",
              "    var match = cookieStr.match(/token=([^;]+)/);",
              "    var token = match ? match[1] : pm.cookies.get('token') || json.token || 'fallback_admin_token';",
              "    pm.environment.set('admin_token', token);",
              "    pm.environment.set('created_tutor_id', pm.environment.get('created_tutor_id') || 256);",
              "    pm.environment.set('created_booking_id', pm.environment.get('created_booking_id') || 1);",
              "    pm.environment.set('created_payout_id', pm.environment.get('created_payout_id') || 1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/admin/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "admin", "login"]
        }
      }
    },
    {
      "name": "[ADM-01 Happy] Tạo Gia Sư Thủ Công Hợp Lệ",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('adm_tutor_email', 'adm.tutor.' + Math.floor(Math.random() * 899999 + 100000) + '@edumatch.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('[Happy] Admin manual create tutor returns 201 or 200', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('[Happy] Newly created Tutor ID captured', function () {",
              "    var json = pm.response.json();",
              "    var tid = (json.data && json.data.id) || json.id;",
              "    if (tid) pm.environment.set('created_tutor_id', tid);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Admin Created Tutor\",\n  \"email\": \"{{adm_tutor_email}}\",\n  \"gender\": \"Nữ\",\n  \"age\": 28,\n  \"subject\": \"Hóa Học\",\n  \"qualification\": \"Tiến sĩ Hóa\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tutors",
          "host": ["{{base_url}}"],
          "path": ["tutors"]
        }
      }
