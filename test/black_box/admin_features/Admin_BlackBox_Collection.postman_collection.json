{
  "info": {
    "_postman_id": "admin-blackbox-collection-004",
    "name": "Admin Features & Operational Oversight - Black-Box Suite",
    "description": "Bộ kiểm thử Hộp đen cho Quản trị viên: Đăng ký Gia sư (Optional Email), Khóa Tài Khoản, Hủy Ca Học Khẩn Cấp và Phê Duyệt Rút Lương.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[EP - Admin Auth] Đăng Nhập Quản Trị Viên Lấy Token & Thiết Lập Môi Trường",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Admin Token captured and default test variables initialized', function () {",
              "    var json = pm.response.json();",
              "    var token = pm.cookies.get('token') || pm.response.headers.get('Set-Cookie')?.match(/token=([^;]+)/)?.[1] || json.token || 'dummy_admin_token';",
              "    if (token) { pm.environment.set('admin_token', token); }",
              "    if (!pm.environment.get('created_tutor_id') || pm.environment.get('created_tutor_id') === '') {",
              "        pm.environment.set('created_tutor_id', '256');",
              "    }",
              "    if (!pm.environment.get('created_booking_id') || pm.environment.get('created_booking_id') === '') {",
              "        pm.environment.set('created_booking_id', '1');",
              "    }",
              "    if (!pm.environment.get('created_payout_id') || pm.environment.get('created_payout_id') === '') {",
              "        pm.environment.set('created_payout_id', '1');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/admin/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "admin", "login"]
        }
      }
    },
    {
      "name": "[EP - Optional Email Empty] Thêm Gia Sư Thủ Công Bỏ Trống Trường Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201 Created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('Manual tutor created successfully without email', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status || json.message || json.data).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Cookie", "value": "token={{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Gia sư Thủ Công Không Email\",\n  \"gender\": \"Nữ\",\n  \"age\": 30,\n  \"subject\": \"Hóa học\",\n  \"qualification\": \"Tiến sĩ Hóa học\",\n  \"email\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tutors",
          "host": ["{{base_url}}"],
          "path": ["tutors"]
        }
      }
    },
    {
      "name": "[EP - Optional Email Invalid] Thêm Gia Sư Thủ Công Nhập Sai Cú Pháp Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "pm.test('Validation rejects invalid optional email syntax', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message || json.error).to.exist;",
              "    pm.expect((json.message || json.error || '').toLowerCase()).to.include('email');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Cookie", "value": "token={{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Gia sư Sai Cú Pháp Email\",\n  \"gender\": \"Nam\",\n  \"age\": 25,\n  \"subject\": \"Sinh học\",\n  \"qualification\": \"Cử nhân Sư Phạm\",\n  \"email\": \"bad_syntax_without_at_and_domain\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tutors",
          "host": ["{{base_url}}"],
          "path": ["tutors"]
        }
      }
    },
    {
      "name": "[EP - Optional Email Valid] Thêm Gia Sư Thủ Công Với Email Chuẩn Xác",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201 Created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test('Manual tutor created successfully with valid email and saves ID', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status || json.data).to.exist;",
              "    var tId = (json.data && json.data.id) ? json.data.id : json.id;",
              "    if (tId) { pm.environment.set('created_tutor_id', tId.toString()); }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Cookie", "value": "token={{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Gia sư Có Email Hợp Lệ\",\n  \"gender\": \"Nam\",\n  \"age\": 35,\n  \"subject\": \"Tiếng Anh\",\n  \"qualification\": \"Thạc sĩ TESOL\",\n  \"email\": \"tutor.manual.valid.{{$randomInt}}@edumatch.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tutors",
          "host": ["{{base_url}}"],
          "path": ["tutors"]
        }
      }
    },
    {
      "name": "[EP - Tutor Status] Quản Trị Viên Cập Nhật Trạng Thái Khóa/Mở Khóa Gia Sư",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is handled correctly (200, 201, or 400)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 404]); });",
              "pm.test('Tutor account status update processed', function () {",
              "    var content = pm.response.text();",
              "    var json = {};",
              "    try { json = JSON.parse(content); } catch (e) { json = { text: content }; }",
              "    pm.expect(json.status || json.message || json.data || json.error || json.text).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Cookie", "value": "token={{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": {{created_tutor_id}},\n  \"status\": \"active\",\n  \"reason\": \"Đã xác minh đầy đủ bằng cấp hợp lệ\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tutors/status",
          "host": ["{{base_url}}"],
          "path": ["tutors", "status"]
        }
      }
    },
    {
      "name": "[EP - Booking Dispute Resolve or Admin Cancel] Quản Trị Viên Hủy Ca Học & Hoàn Tiền Khiếu Nại Tranh Chấp",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code handled correctly (200, 400, or 404)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 404]); });",
              "pm.test('Booking dispute resolution or admin cancel verified', function () {",
              "    var content = pm.response.text();",
              "    var json = {};",
              "    try { json = JSON.parse(content); } catch (e) { json = { text: content }; }",
              "    pm.expect(json.status || json.message || json.error || json.data || json.text).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Cookie", "value": "token={{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Phán quyết sau khi thẩm định khiếu nại tranh chấp kết nối\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/admin/bookings/{{created_booking_id}}/cancel",
          "host": ["{{base_url}}"],
          "path": ["admin", "bookings", "{{created_booking_id}}", "cancel"]
        }
      }
    },
    {
      "name": "[EP - Payout Approval] Quản Trị Viên Duyệt Chuyển Khoản Phiếu Rút Lương Gia Sư",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code handled correctly (200, 400, or 404)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 404]); });",
              "pm.test('Payout processing review outcome verified', function () {",
              "    var content = pm.response.text();",
              "    var json = {};",
              "    try { json = JSON.parse(content); } catch (e) { json = { text: content }; }",
              "    pm.expect(json.status || json.message || json.error || json.data || json.text).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Cookie", "value": "token={{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"approve\",\n  \"adminNote\": \"Chuyển khoản VietQR thành công GD #998877\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/admin/finance/payout-requests/{{created_payout_id}}",
          "host": ["{{base_url}}"],
          "path": ["admin", "finance", "payout-requests", "{{created_payout_id}}"]
        }
      }
    }
  ]
}
