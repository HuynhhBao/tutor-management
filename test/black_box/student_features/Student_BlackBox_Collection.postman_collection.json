        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 402 Payment Required or 400', function () { pm.expect(pm.response.code).to.be.oneOf([400, 402]); });",
              "pm.test('Escrow security rule blocks booking on zero/insufficient wallet balance', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message || json.error).to.exist;",
              "});"
            ]
