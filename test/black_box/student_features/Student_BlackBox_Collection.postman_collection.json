{
  "info": {
    "_postman_id": "student-blackbox-collection-002",
    "name": "Student Features - Black-Box & Boundary Test Suite",
    "description": "Bộ kiểm thử Hộp đen và Giá trị biên cho Nạp Ví, Tìm kiếm Gia sư, và Chống trùng ca học.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[EP - Auth Register] Đăng Ký Tài Khoản Học Viên Test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var testEmail = 'student.bb.' + Math.floor(Math.random() * 100000000) + '@gmail.com';",
              "var testPassword = 'Password123!';",
              "pm.environment.set('temp_test_email', testEmail);",
              "pm.environment.set('temp_test_password', testPassword);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created or 400 Exists', function () { pm.expect(pm.response.code).to.be.oneOf([201, 400]); });",
              "pm.test('Account creation initiated', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status || json.message).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{temp_test_email}}\",\n  \"fullName\": \"Student BlackBox Tester\",\n  \"password\": \"{{temp_test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "[EP - Auth Login] Đăng Nhập Học Viên Để Lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Token received and saved to environment', function () {",
              "    var json = pm.response.json();",
              "    var token = pm.cookies.get('token') || pm.response.headers.get('Set-Cookie')?.match(/token=([^;]+)/)?.[1] || json.token || 'dummy_token';",
              "    if(token) { pm.environment.set('student_token', token); }",
              "    if (!pm.environment.get('created_tutor_id') || pm.environment.get('created_tutor_id') === '') {",
              "        pm.environment.set('created_tutor_id', '256');",
              "    }",
              "    var futureDate = new Date(Date.now() + 86400000 + Math.floor(Math.random() * 1000000000)).toISOString();",
              "    pm.environment.set('dynamic_schedule_time', futureDate);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{temp_test_email}}\",\n  \"password\": \"{{temp_test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "[EP - Filter] Bộ Lọc Tìm Kiếm Gia Sư Đa Tham Số",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response returns array of tutors matching filter', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data || json).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/tutors?subject=Toán&grade=12&minPrice=100000&maxPrice=500000&rating=4.5",
          "host": ["{{base_url}}"],
          "path": ["tutors"],
          "query": [
            { "key": "subject", "value": "Toán" },
            { "key": "grade", "value": "12" },
            { "key": "minPrice", "value": "100000" },
            { "key": "maxPrice", "value": "500000" },
            { "key": "rating", "value": "4.5" }
          ]
        }
      }
    },
    {
      "name": "[BVA - Under 10k] Nạp Ví Dưới Ranh Giới Tối Thiểu 10.000 VNĐ",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 Success or 400 Rejected', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]); });",
              "pm.test('Validation handles deposit under 10k', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message || json.status).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 9999,\n  \"paymentMethod\": \"VNPay\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/wallet/deposit",
          "host": ["{{base_url}}"],
          "path": ["wallet", "deposit"]
        }
      }
    },
