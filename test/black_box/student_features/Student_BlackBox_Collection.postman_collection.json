    {
      "name": "[EP - Valid Booking] Đặt Lịch Gia Sư Hợp Lệ Để Lưu Booking ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Booking created successfully and ID persisted', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data).to.exist;",
              "    if(json.data && json.data.id) {",
              "        pm.environment.set('created_booking_id', json.data.id);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": {{created_tutor_id}},\n  \"subject\": \"Toán học\",\n  \"scheduleTime\": \"{{dynamic_schedule_time}}\",\n  \"duration\": 2\n}"
        },
        "url": {
          "raw": "{{base_url}}/student/bookings",
          "host": ["{{base_url}}"],
          "path": ["student", "bookings"]
        }
      }
    },
