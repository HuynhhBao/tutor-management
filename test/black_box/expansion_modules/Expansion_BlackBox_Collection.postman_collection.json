      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code handled correctly (200 OK or 404)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });",
              "pm.test('Classroom messaging history retrieved successfully', function () {",
              "    var content = pm.response.text();",
              "    var json = {};",
              "    try { json = JSON.parse(content); } catch (e) { json = { text: content }; }",
              "    pm.expect(json.status || json.data || json.message || json.error || json.text).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/class-session/{{created_booking_id}}/messages",
          "host": ["{{base_url}}"],
          "path": ["class-session", "{{created_booking_id}}", "messages"]
        }
      }
    },
    {
      "name": "[EP - Notifications Mark All Read] Kiểm Định Đánh Dấu Tất Cả Thông Báo Đã Đọc",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('All unread user notifications marked as read', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status || json.message || json.data).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
