          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/notifications/read-all",
          "host": ["{{base_url}}"],
          "path": ["notifications", "read-all"]
        }
      }
    },
    {
      "name": "[EP - Notifications List] Lấy Danh Sách Thông Báo Realtime Chuông Báo Của Người Dùng",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Notifications payload retrieved with correct structure', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status || json.data || json.notifications).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
