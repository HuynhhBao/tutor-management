{
  "info": {
    "_postman_id": "expansion-blackbox-collection-005",
    "name": "Expansion Modules & AI/Classroom - Black-Box Suite",
    "description": "Bộ kiểm thử Hộp đen cho Trợ lý AI Tìm Gia Sư, Phòng học trực tuyến Virtual Classroom, Tài liệu Lớp học & Thông Báo Realtime.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[EP - Auth Register] Đăng Ký Tài Khoản Học Viên Test Cho Module Expansion",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var testEmail = 'student.exp.' + Math.floor(Math.random() * 100000000) + '@gmail.com';",
              "var testPassword = 'Password123!';",
              "pm.environment.set('temp_exp_email', testEmail);",
              "pm.environment.set('temp_exp_password', testPassword);",
              "if (!pm.environment.get('created_booking_id') || pm.environment.get('created_booking_id') === '') {",
              "    pm.environment.set('created_booking_id', '1');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created or 400 Exists', function () { pm.expect(pm.response.code).to.be.oneOf([201, 400]); });",
              "pm.test('Student registration initiated for expansion tests', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status || json.message).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{temp_exp_email}}\",\n  \"fullName\": \"Expansion Student Tester\",\n  \"password\": \"{{temp_exp_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "[EP - Auth Login] Đăng Nhập Học Viên Để Lấy Token Bảo Mật",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Student token received and saved to environment', function () {",
              "    var json = pm.response.json();",
              "    var token = pm.cookies.get('token') || pm.response.headers.get('Set-Cookie')?.match(/token=([^;]+)/)?.[1] || json.token || 'dummy_exp_token';",
              "    if(token) { pm.environment.set('student_token', token); }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{temp_exp_email}}\",\n  \"password\": \"{{temp_exp_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "[EP - AI Matchmaker Natural NLP] Đưa Từ Khóa Ngữ Liệu Tự Nhiên Cho Trợ Lý AI Tìm Gia Sư",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code handled appropriately (200 OK or AI Service unavailable 500/503)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 500, 503]); });",
              "pm.test('AI algorithm processes matchmaking prompt or returns structured message', function () {",
              "    var content = pm.response.text();",
              "    var json = {};",
              "    try { json = JSON.parse(content); } catch (e) { json = { text: content }; }",
              "    pm.expect(json.status || json.recommendations || json.data || json.message || json.error || json.text).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Tôi cần tìm gia sư dạy Văn lớp 10 ôn thi, vui vẻ nhẹ nhàng, giá dưới 300k/giờ\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/ai/matchmaker",
          "host": ["{{base_url}}"],
          "path": ["ai", "matchmaker"]
        }
      }
    },
    {
      "name": "[EP - Virtual Classroom Canvas Snapshot] Lưu Bảng Vẽ Tương Tác Đồng Bộ Trong Phiên Học Trực Tuyến",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code handled correctly (200, 400, or 404)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 404]); });",
              "pm.test('Canvas snapshot recorded or validation response received', function () {",
              "    var content = pm.response.text();",
              "    var json = {};",
              "    try { json = JSON.parse(content); } catch (e) { json = { text: content }; }",
              "    pm.expect(json.status || json.message || json.error || json.text).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"snapshot\": \"{\\\"lines\\\":[{\\\"x\\\":10,\\\"y\\\":20,\\\"color\\\":\\\"#3b82f6\\\"}]}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/class-session/{{created_booking_id}}/snapshot",
          "host": ["{{base_url}}"],
          "path": ["class-session", "{{created_booking_id}}", "snapshot"]
        }
      }
    },
    {
      "name": "[EP - Classroom File Upload Missing] Tải Lên Tài Liệu Lớp Học Thiếu Trường File (Validation Check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "pm.test('System enforces file inclusion requirement for classroom upload', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message || json.error).to.exist;",
              "    pm.expect((json.message || json.error || '').toLowerCase()).to.include('file');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{student_token}}" },
          { "key": "Cookie", "value": "token={{student_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/class-session/upload",
          "host": ["{{base_url}}"],
          "path": ["class-session", "upload"]
        }
      }
    },
    {
